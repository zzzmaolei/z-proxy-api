# ==============================================================================
# z.proxy.api 环境变量配置文件模板 (Environment Variables Template)
# 使用方法：复制本文件为 .env 并根据实际部署环境修改对应配置项
# Usage: Copy this file to .env and configure parameters as needed
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础服务网络配置 (Network & Server Settings)
# ------------------------------------------------------------------------------

# 服务监听端口 (HTTP Server Port)
# 默认推荐: 8080 (Docker 与生产反代常用端口)
SERVICE_PORT=8080

# 监听地址 (Listen Address)
# 留空表示监听所有网卡 (0.0.0.0)；若仅限本机访问可设为 127.0.0.1
LISTEN_ADDRESS=

# 运行环境 (Runtime Environment: production / development / test)
NODE_ENV=production


# ------------------------------------------------------------------------------
# 2. 鉴权与安全密钥配置 (Authentication & API Keys)
# ------------------------------------------------------------------------------

# 管理员密钥 (Admin Secret Key)
# 拥有管理台全部权限（可访问前端 Dashboard、修改运行时配置、管理账号池等）
ADMIN_KEY=sk-admin-yourkey

# API 密钥列表 (API Access Keys)
# 支持单个或多个密钥，以英文逗号分隔。
# 规则：若未单独设置 ADMIN_KEY，第一个密钥自动作为管理员密钥；后续密钥为普通调用密钥（仅限 API 请求）
# 示例: API_KEY=sk-admin-yourkey,sk-client-key1,sk-client-key2
API_KEY=sk-admin-yourkey


# ------------------------------------------------------------------------------
# 3. 集群与并发控制 (Cluster & Concurrency)
# ------------------------------------------------------------------------------

# 集群工作进程数 (Cluster Worker Processes)
# 1: 单进程运行（推荐本地开发或资源受限环境）
# max: 自动占用全部 CPU 物理核心数
# 数字: 指定进程数量，如 2, 4 等
CLUSTER_WORKERS=1

# PM2 进程实例数（与 CLUSTER_WORKERS 对齐，用于 PM2 进程守护配置）
PM2_INSTANCES=1

# PM2 内存超限保护阈值 (超过后自动重启进程，如 1G, 2G)
PM2_MAX_MEMORY=2G


# ------------------------------------------------------------------------------
# 4. 数据存储与持久化模式 (Data Persistence)
# ------------------------------------------------------------------------------

# 数据保存模式 (Data Save Mode: file / redis / none)
# - file : 本地 JSON 文件持久化（保存至 data/qwen-data.json 与 data/dpsk-data.json，适合单机部署）
# - redis: 远程/本地 Redis 共享存储（适合多 Worker 高并发集群部署）
# - none : 仅内存/环境变量模式（无持久化）
DATA_SAVE_MODE=file

# Redis 连接字符串 (当 DATA_SAVE_MODE=redis 时必填)
# 示例: redis://127.0.0.1:6379 或 TLS 模式 rediss://default:password@host:port
REDIS_URL=redis://127.0.0.1:6379


# ------------------------------------------------------------------------------
# 5. 网络代理配置 (Proxy & Reverse Proxy)
# ------------------------------------------------------------------------------

# 全局网络代理 (HTTP/HTTPS/SOCKS5 Proxy)
# 当服务器网络无法直接访问海外上游或需要打散出口 IP 时配置
# 留空表示直连；可配置本地梯子或专线代理，例如: http://127.0.0.1:7890 或 socks5://127.0.0.1:1080
PROXY_URL=

# 千问 Web 端自定义反代基地址 (留空使用官方默认 https://chat.qwen.ai)
QWEN_CHAT_PROXY_URL=

# TLS 指纹侧车开关 (TLS Sidecar for uTLS Fingerprint Emulation)
# 可选值: false (关闭) / true 或 all (全局启用) / dpsk (仅对 DeepSeek 启用) / qwen (仅对千问启用)
TLS_SIDECAR_ENABLED=false
TLS_SIDECAR_PORT=9091


# ------------------------------------------------------------------------------
# 6. 模型思考过程与协议输出控制 (Thinking & Reasoning)
# ------------------------------------------------------------------------------

# 思考过程输出格式 (Thinking Output Format: both / reasoning_content / text)
# both: 同时在 reasoning_content 字段与正文标签中输出，兼容绝大多数客户端
# reasoning_content: 标准 OpenAI/Anthropic 思维链协议输出
THINKING_OUTPUT_FORMAT=both

# 是否输出思考过程 (Whether to output thinking blocks)
# 默认 true。设为 false 时将抑制思考流输出，仅回传最终正文
OUTPUT_THINK=true

# DeepSeek 默认思考程度 (low / medium / high / max)
# 客户端未指定 reasoning_effort 时生效；high 为开启思考并使用高权重
DPSK_THINK_EFFORT=high

# 搜索来源与引用卡片显示格式 (table / text)
SEARCH_INFO_MODE=table


# ------------------------------------------------------------------------------
# 7. 调度器、重试与防风控节拍 (Scheduler, Retry & Pacing)
# ------------------------------------------------------------------------------

# DeepSeek 多账号路由调度策略 (round-robin: 轮询 / idle-first: 空闲优先)
DPSK_ROUTING_STRATEGY=round-robin

# DeepSeek 单账号最小平滑呼吸间隔 (毫秒)
# 默认 5000 (5秒)。当账号池有多个就绪账号时，优先让刚调用完的账号充分休息，防止单号高频触发反爬
DPSK_MIN_PACING_INTERVAL_MS=5000

# Chat 上游请求失败重试次数 (0 表示不重试)
CHAT_RETRY_COUNT=3

# 重试退避等待基数 (毫秒)
CHAT_RETRY_BACKOFF_MS=400

# 简化模型映射 (Simplified Model Map)
# true: 仅返回基础模型 ID
# false: 返回包含 -thinking, -search 等完整变体列表
SIMPLE_MODEL_MAP=false


# ------------------------------------------------------------------------------
# 8. Token 统计与流式传输 (Token Usage & Stream Optimization)
# ------------------------------------------------------------------------------

# Token 统计计算模式 (auto / estimate / precise)
# - auto    : 优先透传上游返回的真实 usage 字段（默认推荐）
# - estimate: 基于字符数快速估算（极低 CPU 占用）
# - precise : 基于 tiktoken 本地精准分词编码（计算密集）
TOKEN_USAGE_MODE=auto

# Chat ID 预热补池并发与启动预算
CHAT_ID_PREWARM_MODE=full
CHAT_ID_POOL_SIZE=4


# ------------------------------------------------------------------------------
# 9. 日志输出控制 (Logging)
# ------------------------------------------------------------------------------

# 日志输出级别 (DEBUG / INFO / WARN / ERROR)
LOG_LEVEL=INFO

# 是否落盘保存文件日志
ENABLE_FILE_LOG=false

# 日志目录与轮转切分
LOG_DIR=./logs
MAX_LOG_FILE_SIZE=500
MAX_LOG_FILES=10
